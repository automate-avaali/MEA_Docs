MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=mea_arabic_chatbot
JWT_SECRET=<random 64 hex chars>
APP_URL=http://localhost:3000

GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.5-flash-lite
OCR_PAGES_PER_REQUEST=5

# Embeddings: BAAI/bge-m3 only (never switch models without re-embedding). Configure ONE OR MORE providers of
# that same model; they are tried in this order and a provider that is out of credits is skipped for 10 min.
# own TEI server / HF Inference Endpoint, e.g. https://xxx.endpoints.huggingface.cloud/embed
EMBED_URL=
# bearer token for EMBED_URL, if it needs one
EMBED_TOKEN=
# Cloudflare Workers AI (@cf/baai/bge-m3) — free daily allowance
CF_ACCOUNT_ID=
CF_API_TOKEN=
# DeepInfra BAAI/bge-m3 — pay-as-you-go
DEEPINFRA_API_KEY=
# Hugging Face Inference Providers (needs credits / PRO)
HF_TOKEN=

JINA_API_KEY=
JINA_RERANK_MODEL=jina-reranker-v3.5

# LLM. MISTRAL_ENABLED=true → Mistral first, Fanar as the fallback. Unset/false → Fanar only.
MISTRAL_ENABLED=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

FANAR_API_KEY=
FANAR_BASE_URL=https://api.fanar.qa/v1
FANAR_MODEL=Fanar-C-2-27B

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Atlas Search / Vector Search indexes are created manually in the Atlas UI (docs/atlas-indexes.md)
SMTP_FROM=
ATLAS_AUTO_INDEXES=false

# Sign-up is open by default. A browser where a limited account (e.g. a client account) has signed in no longer
# offers sign-up. Set SIGNUP_ENABLED=false to close sign-up for everyone.
SIGNUP_ENABLED=

# Original uploaded files → a PRIVATE Vercel Blob store. When connecting the store to the Vercel project, tick
# "Add a read-write token env var to this connection" (keep the prefix BLOB) — browser uploads need this token.
# Unset → files are indexed but not kept.
BLOB_READ_WRITE_TOKEN=
